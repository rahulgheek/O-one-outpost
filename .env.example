# =============================================================================
# Analytics Service - independent environment template
# =============================================================================
# Botkeep: paste these keys into the workload's Environment panel.
# Local:   copy this file to analytics-service/.env (never commit the .env).
# =============================================================================

# PostgreSQL (Neon or any managed PostgreSQL)
DB_URL=jdbc:postgresql://REPLACE_WITH_NEON_HOST/neondb?sslmode=require
DB_USER=REPLACE_WITH_DB_USER
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# Services that analytics monitors. These are called by the service itself,
# so they must be reachable over the public HTTPS domains.
AUTH_SERVICE_URL=https://auth.yourdomain.com
ASSESSMENT_SERVICE_URL=https://assessment.yourdomain.com
ARENA_SERVICE_URL=https://arena.yourdomain.com
SANDBOX_URL=https://sandbox.yourdomain.com
GATEWAY_URL=https://api.yourdomain.com

# Shared internal secret. Must be identical across all services.
INTERNAL_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

LOG_LEVEL_ANALYTICS=INFO
LOG_LEVEL_WEB=INFO
