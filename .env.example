# =============================================================================
# Assessment Service - independent environment template
# =============================================================================
# Botkeep: paste these keys into the workload's Environment panel.
# Local:   copy this file to assessment-service/.env (never commit the .env).
# =============================================================================

# MongoDB Atlas (or any MongoDB). The database name is part of the URI.
ASSESSMENT_MONGO_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER/AlgoArena_Assessment?retryWrites=true&w=majority

# Full sandbox execute endpoint (sandbox runs on a Docker VPS, not Botkeep).
SANDBOX_URL=https://sandbox.yourdomain.com/api/sandbox/execute

# Shared internal secret. Must be identical across all services.
INTERNAL_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Audit log sink
ANALYTICS_SERVICE_URL=https://analytics.yourdomain.com

# Assessment timestamps
APP_TIMEZONE=Asia/Kolkata

LOG_LEVEL_ASSESSMENT=INFO
LOG_LEVEL_WEB=INFO
