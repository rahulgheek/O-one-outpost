# =============================================================================
# code-sandbox environment template
# =============================================================================
# PRIMARY BACKEND: OnlineCompiler.io over HTTPS. It needs no Docker host and no
# Docker CLI. Paste your API key below (or into the Pterodactyl panel) and keep
# it server-side; never commit a filled-in file.
#
# SECONDARY BACKEND: the warm Docker ContainerPool. It remains in the codebase
# but is inactive unless JUDGE_EXECUTION_BACKEND=docker and an explicit Docker
# Engine endpoint is configured. See deploy/pterodactyl/code-sandbox.md or
# deploy/vps/code-sandbox/README.md. Docker settings are intentionally not
# active in this template, so copying it can never contact a Docker daemon.
# =============================================================================

# Shared internal secret. Must be identical across all services.
INTERNAL_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Audit log sink.
ANALYTICS_SERVICE_URL=https://analytics.yourdomain.com

# The port the application listens on (the Dockerfile exposes 8085).
SERVER_PORT=8085

LOG_LEVEL_SANDBOX=INFO

# =============================================================================
# Execution backend
# =============================================================================
# onlinecompiler (default) | docker (secondary; requires an explicit
# JUDGE_DOCKER_HOST or JUDGE_DOCKER_SSH_HOST)
JUDGE_EXECUTION_BACKEND=onlinecompiler
JUDGE_ENABLED=true
JUDGE_API_ONLY_MODE=false

# =============================================================================
# OnlineCompiler.io (primary - no Docker host required)
# =============================================================================
# Get a key at https://api.onlinecompiler.io/compilers/api-keys/
# The key is sent raw in the Authorization header and is never logged.
ONLINECOMPILER_API_KEY=
ONLINECOMPILER_BASE_URL=https://api.onlinecompiler.io
# Java runtime id from https://onlinecompiler.io/docs/compilers
ONLINECOMPILER_COMPILER=openjdk-25

ONLINECOMPILER_CONNECT_TIMEOUT_MS=5000
# Provider hard ceiling is 30s; this must stay above it.
ONLINECOMPILER_RESPONSE_TIMEOUT_MS=45000
ONLINECOMPILER_QUEUE_TIMEOUT_MS=30000

# Free/Starter accounts allow 4 simultaneous runs and 60 submissions/minute.
ONLINECOMPILER_MAX_CONCURRENCY=4
# Retries only apply to HTTP 429/503, where the run did not start.
ONLINECOMPILER_MAX_RETRIES=2
ONLINECOMPILER_RETRY_BASE_MS=750
ONLINECOMPILER_RETRY_MAX_MS=5000

# Provider limits: 100,000 code bytes and 5 MB stdin.
ONLINECOMPILER_MAX_CODE_BYTES=100000
ONLINECOMPILER_MAX_INPUT_BYTES=5242880

# The provider counts mapped JVM/runtime files in its memory figure (~230 MB
# for plain Java). Requested problem memory + this headroom is sent as the
# provider memory_limit. Explicit configuration only; never auto-tuned.
ONLINECOMPILER_MEMORY_HEADROOM_MB=256
# 512 MB on Free/Starter; paid plans may allow up to 2048 MB.
ONLINECOMPILER_MAX_MEMORY_MB=512

# Loopback mock servers only. Keep false in production.
ONLINECOMPILER_ALLOW_INSECURE_HTTP=false

# =============================================================================
# Judge limits
# =============================================================================
# Time limits are milliseconds. Default 2000ms, hard ceiling 10000ms (the
# OnlineCompiler Free/Starter plan caps a single run at 30s).
DEFAULT_TIME_LIMIT_MS=2000
MAX_TIME_LIMIT_MS=10000

# Memory limits are MB. Requests are clamped to [min, max].
DEFAULT_MEMORY_LIMIT_MB=256
MAX_MEMORY_LIMIT_MB=512
MIN_MEMORY_LIMIT_MB=64

# Explicit reference-environment calibration. This is NOT auto-tuned from host
# speed or load. Keep 1.0 unless you calibrated against a reference environment.
JUDGE_TIME_LIMIT_MULTIPLIER=1.0
# Docker limit. The OnlineCompiler backend always applies the lower provider
# limit (ONLINECOMPILER_MAX_CODE_BYTES) during request validation.
JUDGE_MAX_CODE_BYTES=262144

# =============================================================================
# Secondary backend (optional) - warm Docker ContainerPool
# =============================================================================
# Not needed for OnlineCompiler. Read the Docker guide first. An explicit host
# is mandatory; selecting docker without one aborts startup instead of falling
# back to a local socket. These values must be real process environment
# variables (Pterodactyl Startup panel, Compose environment, or an exported
# shell variable), not only entries in a locally imported .env file.
#
# JUDGE_EXECUTION_BACKEND=docker
# JUDGE_DOCKER_HOST=ssh://judge@docker-host:22
# JUDGE_DOCKER_SSH_USER=judge
# JUDGE_DOCKER_SSH_KEY_PATH=/home/container/.ssh/id_ed25519
# JUDGE_DOCKER_SSH_KNOWN_HOSTS=/home/container/.ssh/known_hosts
# JUDGE_DOCKER_SSH_STRICT_HOST_KEY_CHECKING=true
#
# Or mutual TLS:
# JUDGE_DOCKER_HOST=tcp://docker-host:2376
# JUDGE_DOCKER_TLS_VERIFY=1
# JUDGE_DOCKER_CERT_PATH=/home/container/certs
#
# Local Docker VPS only:
# JUDGE_DOCKER_HOST=unix:///var/run/docker.sock
#
# Loopback development only (never remote):
# JUDGE_DOCKER_HOST=tcp://127.0.0.1:2375
# JUDGE_DOCKER_ALLOW_INSECURE_TCP=true
#
# Pool size and lifecycle:
# JUDGE_POOL_SIZE=3
# JUDGE_POOL_WARMUP_ON_STARTUP=true
# JUDGE_POOL_WARMUP_BLOCKING=true
# JUDGE_POOL_STARTUP_TIMEOUT_MS=10000
# JUDGE_POOL_BORROW_TIMEOUT_MS=10000
# JUDGE_REQUIRE_DOCKER=true
