# =============================================================================
# Auth Service - independent environment template
# =============================================================================
# Botkeep: paste these keys into the workload's Environment panel.
# Local:   copy this file to auth-service/.env (never commit the .env).
# =============================================================================

# PostgreSQL (Neon or any managed PostgreSQL)
DB_URL=jdbc:postgresql://REPLACE_WITH_NEON_HOST/neondb?sslmode=require
DB_USER=REPLACE_WITH_DB_USER
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# Must be identical to gateway-service JWT_SECRET.
JWT_SECRET=REPLACE_WITH_BASE64_SECRET
JWT_EXPIRATION=86400000

# Redis (OTP storage). Set REDIS_SSL=false for plain Redis.
REDIS_HOST=REPLACE_WITH_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_SSL=true

# SMTP (Brevo or any SMTP provider)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=2525
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM=REPLACE_WITH_VERIFIED_SENDER

# Shared internal secret. Must be identical across all services.
INTERNAL_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Audit log sink
ANALYTICS_SERVICE_URL=https://analytics.yourdomain.com

# Keep SQL logging off in production.
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

LOG_LEVEL_AUTH=INFO
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_WEB=INFO
