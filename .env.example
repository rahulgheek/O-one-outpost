# =============================================================================
# Code Sandbox - independent environment template (Docker VPS, not Botkeep)
# =============================================================================
# This service needs access to /var/run/docker.sock, so it must run on a
# Docker-capable VPS. Copy this file to code-sandbox/.env on that VPS.
# =============================================================================

# Shared internal secret. Must be identical across all services.
INTERNAL_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Audit log sink
ANALYTICS_SERVICE_URL=https://analytics.yourdomain.com

# The port the container listens on (the Dockerfile exposes 8085).
SERVER_PORT=8085

# JVM options used by the Dockerfile entrypoint.
JAVA_OPTS=-Xms64m -Xmx256m -Xss256k -XX:+UseG1GC -XX:MaxGCPauseMillis=100

LOG_LEVEL_SANDBOX=INFO
