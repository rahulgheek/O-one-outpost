# =============================================================================
# Gateway Service - independent environment template
# =============================================================================
# Botkeep: paste these keys into the workload's Environment panel.
# Local:   copy this file to gateway-service/.env (never commit the .env).
# =============================================================================

# Must be identical to auth-service JWT_SECRET.
# Generate one with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_BASE64_SECRET

# Must be identical across gateway, auth, arena, assessment, analytics and
# code-sandbox. Generate one with: openssl rand -hex 48
INTERNAL_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Redis (Upstash works out of the box). Set REDIS_SSL=false for plain Redis.
REDIS_HOST=REPLACE_WITH_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_SSL=true

# Downstream service URLs. Use the public HTTPS domains attached in Botkeep,
# never localhost or an internal Docker name.
AUTH_SERVICE_URL=https://auth.yourdomain.com
ARENA_SERVICE_URL=https://arena.yourdomain.com
ARENA_WS_URL=wss://arena.yourdomain.com
ANALYTICS_SERVICE_URL=https://analytics.yourdomain.com
ASSESSMENT_SERVICE_URL=https://assessment.yourdomain.com

# Comma-separated list of frontend origins allowed by the gateway.
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://*.vercel.app,http://localhost:*

# Logging (INFO keeps production log volume and memory low).
LOG_LEVEL_GATEWAY=INFO
LOG_LEVEL_WEB=INFO
