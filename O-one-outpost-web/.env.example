# =============================================================================
# Frontend - independent environment template
# =============================================================================
# Vite reads these at BUILD time. Set them in Vercel (Project Settings ->
# Environment Variables) or before running `npm run build` on Botkeep.
# =============================================================================

# Public gateway domain
VITE_API_GATEWAY_URL=https://api.yourdomain.com

# WebSocket traffic goes through the gateway route /ws-arena.
# The app converts wss:// to https:// for SockJS automatically.
VITE_ARENA_WS_URL=wss://api.yourdomain.com
