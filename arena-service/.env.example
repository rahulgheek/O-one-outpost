# =============================================================================
# Arena Service - independent environment template
# =============================================================================
# Botkeep: paste these keys into the workload's Environment panel.
# Local:   copy this file to arena-service/.env (never commit the .env).
# =============================================================================

# MongoDB Atlas (or any MongoDB). The database name is part of the URI.
ARENA_MONGO_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER/AlgoArena_Arena?retryWrites=true&w=majority

# Full sandbox execute endpoint (sandbox runs on a Docker VPS, not Botkeep).
SANDBOX_URL=https://sandbox.yourdomain.com/api/sandbox/execute

# Shared internal secret. Must be identical across all services.
INTERNAL_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Audit log sink
ANALYTICS_SERVICE_URL=https://analytics.yourdomain.com

# Browser origins allowed to open the arena WebSocket directly.
# Keep this aligned with the gateway CORS list.
ARENA_ALLOWED_ORIGINS=https://app.yourdomain.com,http://localhost:*

LOG_LEVEL_ARENA=INFO
LOG_LEVEL_WEB=INFO
