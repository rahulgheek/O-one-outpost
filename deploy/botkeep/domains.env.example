# =============================================================================
# Domain map — replace yourdomain.com everywhere
# =============================================================================
# This file is a checklist, not a file consumed by the services. Each service's
# .env.example already contains the full URLs using the placeholders below.
# =============================================================================

# Botkeep workloads
GATEWAY_DOMAIN=api.yourdomain.com
AUTH_DOMAIN=auth.yourdomain.com
ARENA_DOMAIN=arena.yourdomain.com
ASSESSMENT_DOMAIN=assessment.yourdomain.com
ANALYTICS_DOMAIN=analytics.yourdomain.com

# Docker VPS (Caddy + code-sandbox)
SANDBOX_DOMAIN=sandbox.yourdomain.com

# Vercel (or Botkeep static)
FRONTEND_DOMAIN=app.yourdomain.com

# Derived URLs used by the services
GATEWAY_URL=https://api.yourdomain.com
AUTH_SERVICE_URL=https://auth.yourdomain.com
ARENA_SERVICE_URL=https://arena.yourdomain.com
ARENA_WS_URL=wss://arena.yourdomain.com
ASSESSMENT_SERVICE_URL=https://assessment.yourdomain.com
ANALYTICS_SERVICE_URL=https://analytics.yourdomain.com
SANDBOX_URL=https://sandbox.yourdomain.com
SANDBOX_EXECUTE_URL=https://sandbox.yourdomain.com/api/sandbox/execute
FRONTEND_ORIGIN=https://app.yourdomain.com
